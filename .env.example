DJANGO_SECRET_KEY=dev-only-key-not-for-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

DB_NAME=lab_batch
DB_USER=root
DB_PASSWORD=<在此填写本机 MySQL 密码>
DB_HOST=127.0.0.1
DB_PORT=3306

MEDIA_ROOT=
MIN_GROUP_SIZE=10

# 工号假名化的盐值。留空时用开发默认值，生产环境必须换成随机字符串。
SUBJECT_SALT=<随机字符串>

# 解读用的模型。留空时解读走模板输出，不调用外部服务。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
