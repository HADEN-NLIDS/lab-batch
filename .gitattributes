# 统一换行符：仓库内一律 LF，检出时按平台转换
* text=auto eol=lf

# Python 与文档
*.py     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.jsonl  text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Windows 脚本保持 CRLF
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制，不做转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.zip    binary
*.pdparams binary
*.pdopt  binary
*.safetensors binary
